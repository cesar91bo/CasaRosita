@page "/configuracion"
@attribute [Authorize(Roles="Administrador")]
@inherits StorePage
@inject Administration Admin
@inject BackupService Backup
@inject LocalOptions Local
<PageTitle>Configuración · Casa Rosita</PageTitle>
<p class="eyebrow">ADMINISTRACIÓN</p><h1>Configuración</h1><Feedback Error="@Error" Notice="@Notice"/>
@if(shop is not null){<section class="panel"><h2>Datos del negocio</h2><div class="form-grid"><label>Nombre comercial<input @bind="shop.Name" @bind:event="oninput" /></label><label>Razón social<input @bind="shop.LegalName" @bind:event="oninput" /></label><label>CUIT<input @bind="shop.Cuit" @bind:event="oninput" /></label><label>Dirección<input @bind="shop.Address" @bind:event="oninput" /></label><label>Teléfono<input @bind="shop.Phone" @bind:event="oninput" /></label><label>Mensaje del comprobante<input @bind="shop.ReceiptMessage" @bind:event="oninput" /></label><label>Papel para impresión<select @bind="shop.Paper"><option>A4</option><option>80mm</option></select></label><label>Logo (PNG o JPEG, máximo 200 KB)<InputFile OnChange="Logo" accept="image/png,image/jpeg" /></label><label class="check"><input type="checkbox" @bind="shop.AllowNegativeStock"/> Permitir ventas con stock negativo</label></div><button class="btn btn-primary" @onclick="Save" disabled="@Busy">Guardar configuración</button></section>}
<section class="panel"><h2>Copias de seguridad</h2><p>Carpeta actual: <strong>@Local.BackupFolder</strong></p><p>Respaldo diario a las @Local.BackupHour:00. Se conservan @Local.BackupRetention copias verificadas. La carpeta y el horario se ajustan en la instalación para asignar los permisos de SQL Server.</p>
    @if(backups.Count>0){var last=backups[0];<p class="alert @(last.Success?"alert-success":"alert-danger")">Último intento: @last.Created.ToString("g") · @(last.Success?"Creado y verificado":last.Error)</p>}else{<p class="alert alert-warning">Todavía no hay respaldos registrados.</p>}
    <button class="btn btn-primary" @onclick="MakeBackup" disabled="@Busy">@(Busy?"Procesando…":"Crear respaldo ahora")</button><p>Descargá una copia y guardala en un pendrive. Una copia en el mismo disco no protege ante una falla física.</p><table class="table"><thead><tr><th>Fecha</th><th>Resultado</th><th>Copia externa</th></tr></thead><tbody>@foreach(var b in backups){<tr><td>@b.Created.ToString("g")</td><td>@(b.Success?"Verificado":"Falló")</td><td>@if(b.Success){<a href="@($"/respaldo/{b.Id}")" download>Descargar para llevar a pendrive</a>}</td></tr>}</tbody></table>
</section>
<section class="panel"><h2>Usuarios</h2><div class="form-grid"><label>Nuevo usuario<input @bind="name" @bind:event="oninput" autocomplete="off"/></label><label>Contraseña<input type="password" @bind="password" @bind:event="oninput" autocomplete="new-password"/></label><label>Rol<select @bind="role"><option>Vendedor</option><option>Administrador</option></select></label></div><small>Contraseña de 10 caracteres o más con mayúsculas, minúsculas y números.</small><button class="btn btn-primary" @onclick="CreateUser" disabled="@Busy">Crear usuario</button><table class="table"><thead><tr><th>Usuario</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var u in users){<tr><td>@u.UserName</td><td>@(u.Active?"Activo":"Deshabilitado")</td><td><button class="btn btn-light" @onclick="()=>Toggle(u)" disabled="@Busy">@(u.Active?"Deshabilitar":"Habilitar")</button></td></tr>}</tbody></table></section>
<section class="panel"><h2>Facturación ARCA</h2><p>La factura C se emite desde el detalle de una venta confirmada. El certificado, ambiente y punto de venta se configuran en local.json según docs/ARCA.md. Requiere conexión a Internet.</p><p>Las pruebas de homologación no tienen validez fiscal. La clave privada y su contraseña se guardan fuera del sistema y del repositorio.</p></section>
@code{
    ShopSettings? shop;List<BackupRecord> backups=[];List<LocalUser> users=[];string name="",password="",role="Vendedor";
    protected override async Task OnInitializedAsync()=>await Run(Load);
    async Task Load(){await Actor.Require(true);await using var db=await Factory.CreateDbContextAsync();shop=await db.Settings.AsNoTracking().SingleAsync();backups=await db.Backups.AsNoTracking().OrderByDescending(x=>x.Id).Take(Local.BackupRetention).ToListAsync();users=await db.Users.AsNoTracking().OrderBy(x=>x.UserName).ToListAsync();}
    Task Save()=>Run(async()=>{await Admin.SaveSettings(shop!);Notice="Configuración guardada.";});
    Task MakeBackup()=>Run(async()=>{await Actor.Require(true);var result=await Backup.Run();await Load();if(!result.Success)throw new InvalidOperationException(result.Error);Notice="Respaldo creado y verificado. Guardá una copia fuera de esta computadora.";});
    Task CreateUser()=>Run(async()=>{await Admin.CreateUser(name,password,role);name="";password="";await Load();Notice="Usuario creado.";});
    Task Toggle(LocalUser u)=>Run(async()=>{await Admin.SetActive(u.Id,!u.Active);await Load();});
    Task Logo(InputFileChangeEventArgs e)=>Run(async()=>{await Actor.Require(true);var file=e.File;if(file.ContentType is not ("image/png" or "image/jpeg"))throw new InvalidOperationException("Usá un archivo PNG o JPEG.");using var ms=new MemoryStream();await file.OpenReadStream(200000).CopyToAsync(ms);shop!.LogoData=$"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";});
}
