@page "/productos"
@attribute [Authorize]
@inherits StorePage
@inject Catalog Catalog
<PageTitle>Productos · Casa Rosita</PageTitle>
<div class="title-row"><div><p class="eyebrow">CATÁLOGO</p><h1>Productos</h1><p class="muted">Precios claros y stock al día.</p></div>@if(admin){<button class="btn btn-primary" @onclick="()=>edit=new Product {CategoryId=1}">＋ Nuevo producto</button>}</div>
<Feedback Error="@Error" Notice="@Notice"/>
<form class="search-row panel" @onsubmit="Load" @onsubmit:preventDefault><label class="grow">Buscar<input @bind="query" @bind:event="oninput" placeholder="Nombre, código o barras" /></label><button class="btn btn-primary">Buscar</button></form>
@if(edit is not null && admin){<section class="panel"><h2>@(edit.Id==0?"Nuevo producto":"Editar producto")</h2><div class="form-grid">
    <label>Código interno<input @bind="edit.Code" @bind:event="oninput" maxlength="40" /></label><label>Código de barras<input @bind="edit.Barcode" @bind:event="oninput" /></label><label class="wide">Nombre<input @bind="edit.Name" @bind:event="oninput" maxlength="160" /></label>
    <label>Categoría<select @bind="edit.CategoryId">@foreach(var c in categories){<option value="@c.Id">@c.Name</option>}</select></label><label>Unidad<select @bind="edit.Unit"><option>Unidad</option><option>Metro</option></select></label>
    <label>Precio de venta<input type="number" step="0.01" min="0" @bind="edit.Price" @bind:event="oninput" /></label><label>Costo (opcional)<input type="number" step="0.01" min="0" @bind="edit.Cost" @bind:event="oninput" /></label>
    <label>Talle<input @bind="edit.Size" @bind:event="oninput" /></label><label>Color<input @bind="edit.Color" @bind:event="oninput" /></label><label>Stock mínimo<input type="number" step="0.001" min="0" @bind="edit.Minimum" @bind:event="oninput" /></label>
    <label class="check"><input type="checkbox" @bind="edit.TrackStock" /> Controlar stock</label><label class="check"><input type="checkbox" @bind="edit.Active" /> Activo</label>
    </div><p>El stock se carga desde «Ingresar / ajustar stock» después de guardar el producto.</p><div class="actions"><button class="btn btn-primary" @onclick="Save" disabled="@Busy">Guardar producto</button><button class="btn btn-light" @onclick="()=>edit=null">Cancelar</button></div></section>}
@if(adjust is not null){<section class="panel"><h2>Ingresar / ajustar stock · @adjust.Name</h2><p>Disponible: @adjust.Stock.ToString("N3") @adjust.Unit. Un ajuste negativo resta existencias.</p><div class="form-grid"><label>Cantidad del movimiento<input type="number" step="0.001" @bind="delta" @bind:event="oninput" /></label><label>Motivo<input @bind="reason" @bind:event="oninput" placeholder="Ej.: ingreso de mercadería" /></label></div><button class="btn btn-primary" @onclick="Adjust" disabled="@Busy">Registrar movimiento</button><button class="btn btn-light" @onclick="()=>adjust=null">Cancelar</button></section>}
<section class="panel"><table class="table"><thead><tr><th>Código</th><th>Producto</th><th>Categoría</th><th>Precio</th><th>Stock</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in products){<tr><td>@p.Code</td><td><strong>@p.Name</strong><small>@p.Size @p.Color</small></td><td>@p.Category.Name</td><td>@p.Price.ToString("C")</td><td>@p.Stock.ToString("N3") @p.Unit</td><td>@(p.Active?"Activo":"Inactivo")</td><td>@if(admin){<button class="btn btn-light" @onclick="()=>edit=p">Editar</button><button class="btn btn-light" @onclick="()=>{adjust=p;delta=0;reason=string.Empty;}">Stock</button>}<button class="btn btn-light" @onclick="()=>History(p.Id)">Movimientos</button></td></tr>}</tbody></table><p class="muted">Hasta 200 resultados. Refiná la búsqueda para ver otros productos. La baja es lógica para conservar el historial.</p></section>
@if(movements is not null){<section class="panel"><h2>Movimientos de stock</h2><table class="table"><thead><tr><th>Fecha</th><th>Cantidad</th><th>Motivo</th><th>Usuario</th></tr></thead><tbody>@foreach(var m in movements){<tr><td>@m.Created.ToString("g")</td><td>@m.Quantity.ToString("N3")</td><td>@m.Reason</td><td>@m.UserId</td></tr>}</tbody></table></section>}
@code {
    bool admin; string query="",reason=""; decimal delta; List<Product> products=[]; List<Category> categories=[]; Product? edit,adjust; List<StockMovement>? movements;
    protected override async Task OnInitializedAsync(){await Run(async()=>{admin=await Actor.IsAdmin();await LoadCore();});}
    Task Load()=>Run(LoadCore);
    async Task LoadCore(){await Actor.Require();await using var db=await Factory.CreateDbContextAsync();categories=await db.Categories.ToListAsync();products=await db.Products.AsNoTracking().Include(x=>x.Category).Where(x=>(admin||x.Active) && (x.Name.Contains(query)||x.Code.Contains(query)||(x.Barcode!=null&&x.Barcode.Contains(query)))).OrderBy(x=>x.Name).Take(200).ToListAsync();}
    Task Save()=>Run(async()=>{await Catalog.Save(edit!);edit=null;await LoadCore();Notice="Producto guardado.";});
    Task Adjust()=>Run(async()=>{await Catalog.Adjust(adjust!.Id,delta,reason);adjust=null;await LoadCore();Notice="Movimiento de stock registrado.";});
    Task History(int id)=>Run(async()=>{await Actor.Require();await using var db=await Factory.CreateDbContextAsync();movements=await db.StockMovements.Where(x=>x.ProductId==id).OrderByDescending(x=>x.Created).Take(100).ToListAsync();});
}
